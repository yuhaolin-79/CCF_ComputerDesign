<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>灵犀智碳 - 全球二氧化碳浓度重建</title>
    <style>
        /* ========== 基础重置与全局样式 ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        :root {
            --primary-gradient: linear-gradient(90deg, #00f0ff, #7e5bef);
            --bg-dark: #0a0a14;
            --bg-darker: #05050a;
            --text-light: #e0e0ff;
            --text-muted: #a0a0c0;
            --card-bg: rgba(20, 20, 40, 0.7);
            --border-color: rgba(100, 200, 255, 0.1);
            --glow: 0 0 15px rgba(0, 240, 255, 0.5);
        }
        body {
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            background: var(--bg-darker);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ========== 导航栏 ========== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: var(--bg-dark);
            border-bottom: 1px solid var(--border-color);
            backdrop-filter: blur(10px);
            padding: 15px 20px;
        }
        .logo {
            color: #8a2be2;
            font-size: 1.5rem;
            font-weight: bold;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .logo:hover {
            color: #9370db;
        }
        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            justify-content: flex-end;
        }
        nav a {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            background: rgba(10, 10, 20, 0.5);
        }
        nav a:hover, nav a.active {
            color: white;
            background: rgba(100, 200, 255, 0.3);
            box-shadow: var(--glow);
        }

        /* ========== 首页标题 ========== */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            background: var(--bg-dark);
            position: relative;
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('https://via.placeholder.com/1920x1080/0a0a14/05050a?text=Space+Background') no-repeat center center;
            background-size: cover;
            opacity: 0.1;
            z-index: 1;
        }
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
        }
        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            color: white;
            text-shadow: var(--glow);
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero p {
            font-size: 1.2rem;
            margin-bottom: 40px;
            color: var(--text-muted);
        }
        .scroll-down {
            color: var(--text-muted);
            font-size: 0.9rem;
            cursor: pointer;
            animation: bounce 2s infinite;
        }
        @keyframes bounce {
            0%, 20%, 40%, 60%, 80%, 100% { transform: translateY(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateY(-10px); }
        }

        /* ========== 内容卡片 ========== */
        .section {
            padding: 100px 20px;
            background: var(--card-bg);
            border-radius: 15px;
            margin: 50px auto;
            max-width: 1200px;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease;
        }
        .section:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 240, 255, 0.2);
        }
        .section h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            color: var(--primary-gradient);
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: var(--glow);
            text-align: center;
        }
        .section ul {
            list-style: none;
            padding-left: 20px;
        }
        .section li {
            margin-bottom: 15px;
            position: relative;
            padding-left: 25px;
        }
        .section li::before {
            content: '▹';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--text-muted);
            font-size: 1.2rem;
        }
        .highlight {
            color: var(--primary-gradient);
            font-weight: bold;
        }

        /* ========== 项目背景 - 水平布局样式 ========== */
        #background .section-content {
            display: flex;
            gap: 30px; /* 卡片之间的间距 */
            justify-content: center;
        }
        #background .card {
            background: rgba(30, 30, 50, 0.6);
            border-radius: 12px;
            padding: 25px;
            flex: 1; /* 让卡片均分可用空间 */
            min-width: 280px; /* 设置最小宽度 */
            max-width: 350px; /* 限制最大宽度 */
            border: 1px solid var(--border-color);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        #background .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 240, 255, 0.2);
        }
        #background .card h3 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: var(--primary-gradient);
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align: center;
        }
        #background .card ul {
            list-style: none;
            padding-left: 0;
        }
        #background .card li {
            margin-bottom: 12px;
            position: relative;
            padding-left: 20px;
            font-size: 0.95rem;
        }
        #background .card li::before {
            content: '•';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--text-muted);
            font-size: 1.2rem;
        }

        /* ========== 响应式设计：在小屏幕上堆叠 ========== */
        @media (max-width: 900px) {
            #background .section-content {
                flex-direction: column;
                align-items: center;
            }
            #background .card {
                width: 100%;
                max-width: 600px;
            }
        }

        /* ========== 在线提交区域 ========== */
        #generate-image {
            text-align: center;
            margin-top: 50px;
        }
        #co2UploadForm {
            background: rgba(15, 15, 35, 0.8);
            padding: 35px;
            border-radius: 15px;
            max-width: 700px;
            margin: 0 auto;
            border: 1px solid rgba(100, 200, 255, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        }
        #co2UploadForm label {
            display: block;
            margin-bottom: 12px;
            font-weight: 600;
            color: var(--primary-gradient);
            font-size: 1.1rem;
        }
        #co2UploadForm input[type="file"] {
            width: 100%;
            padding: 14px;
            border: 1px solid var(--primary-gradient);
            border-radius: 8px;
            background: rgba(10, 10, 20, 0.8);
            color: var(--text-light);
            font-size: 16px;
            outline: none;
            transition: border 0.3s ease;
        }
        #co2UploadForm input[type="file"]:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 10px rgba(126, 91, 239, 0.5);
        }
        #submitBtn {
            width: 100%;
            padding: 16px;
            margin-top: 20px;
            background: var(--primary-gradient);
            color: #000;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--glow);
        }
        #submitBtn:hover {
            transform: scale(1.02);
            box-shadow: 0 0 25px var(--primary-gradient);
        }
        #submitBtn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        /* ========== 结果展示区 ========== */
        #resultContainer {
            margin-top: 40px;
            text-align: center;
            display: none;
        }
        #loadingMessage, #errorMessage, #imageResult {
            background: rgba(15, 15, 35, 0.8);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid rgba(100, 200, 255, 0.3);
        }
        #loadingMessage p, #errorMessage {
            color: var(--text-light);
            margin-bottom: 15px;
        }
        #errorMessage {
            color: #ff6b6b !important;
            border-color: #ff6b6b;
        }
        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid var(--primary-gradient);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        #generatedImage {
            max-width: 100%;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }

        /* ========== 页脚 ========== */
        footer {
            text-align: center;
            padding: 30px 0;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 40px;
            border-top: 1px solid var(--border-color);
        }
    </style>
</head>
<body>
    <!-- ========== 导航栏 ========== -->
    <header>
        <div class="container">
            <a href="#home" class="logo">灵犀智碳</a>
            <nav>
                <ul>
                    <li><a href="#home" class="active">首页</a></li>
                    <li><a href="#background">项目背景</a></li>
                    <li><a href="#content">实验模型</a></li>
                    <li><a href="#results">实验结果</a></li>
                    <li><a href="#generate-image">生成图像</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- ========== 首页 ========== -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>基于深度学习的<br>全球二氧化碳浓度重建</h1>
            <p>专业实验项目中期汇报</p>
            <div class="scroll-down">向下滚动查看详细内容</div>
        </div>
    </section>

    <!-- ========== 项目背景 (已修改为水平布局) ========== -->
    <section id="background" class="section">
        <h2>项目背景</h2>
        <div class="section-content">
            <!-- 研究背景 -->
            <div class="card">
                <h3>研究背景</h3>
                <ul>
                    <li>领域现状： 随着半导体工艺逼近物理极限，传统硅基芯片的摩尔定律面临失效。</li>
                    <li>技术趋势： 量子隧穿效应导致的漏电问题日益严重，亟需寻找新的计算范式。</li>
                    <li>数据支撑： 根据IEEE最新报告，全球算力需求每3.5个月翻一番，远超硬件发展速度。</li>
                </ul>
            </div>

            <!-- 传统模型 -->
            <div class="card">
                <h3>传统模型</h3>
                <ul>
                    <li>经典计算： 依赖二进制逻辑门，通过电压高低表示0和1。</li>
                    <li>局限性： 在处理大数分解、复杂分子模拟等NP问题时，算力呈指数级下降。</li>
                    <li>瓶颈： 冯·诺依曼架构的"存储墙"问题限制了数据吞吐效率。</li>
                </ul>
            </div>

            <!-- 研究意义 -->
            <div class="card">
                <h3>研究意义</h3>
                <ul>
                    <li>理论价值： 验证量子叠加态在实际运算中的可行性，推动物理学与计算机科学的交叉。</li>
                    <li>应用前景： 一旦突破，将在药物研发、密码破译、气象预测等领域产生颠覆性影响。</li>
                    <li>国家战略： 属于"卡脖子"关键技术，对提升国家科技硬实力具有重大战略意义。</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ========== 实验模型 ========== -->
    <section id="content" class="section">
        <h2>实验模型</h2>
        <ul>
            <li><strong>传统模型不足</strong>
                <ul>
                    <li>数据局限性： 传统的二氧化碳浓度监测主要依赖地面站点观测，空间覆盖不均匀，尤其在海洋和极地地区存在大量数据空白区域。</li>
                    <li>时间分辨率低： 卫星遥感数据虽然能提供全球覆盖，但时间间隔较长，无法捕捉快速变化的局部浓度波动。</li>
                    <li>精度问题： 传统插值方法在处理非线性、多变量关系时精度有限，难以准确反映复杂的气候模式对二氧化碳分布的影响。</li>
                    <li>实时性差： 现有模型通常需要数小时甚至数天的时间来完成一次全球浓度场重建，无法满足实时监测需求。</li>
                </ul>
            </li>
            <li><strong>新模型优势 ✨</strong>
                <ul>
                    <li>深度学习能力： 利用卷积神经网络(CNN)和循环神经网络(RNN)的组合架构，能够自动提取时空特征并建模复杂的非线性关系。</li>
                    <li>多源数据融合： 整合卫星遥感、地面监测站、海洋浮标等多种数据源，显著提升空间覆盖率和数据密度。</li>
                    <li>高精度预测： 通过注意力机制，模型能够关注关键区域和时段，显著提高预测精度，特别是在数据稀疏区域。</li>
                    <li>实时处理能力： 模型经过优化后，能够在分钟级别完成全球浓度场重建，满足实时监测和预警需求。</li>
                </ul>
            </li>
            <li><strong>关键步骤：</strong>
                <ul>
                    <li>数据预处理： 对多源异构数据进行标准化和质量控制。</li>
                    <li>模型训练： 使用历史数据训练深度学习模型，优化参数和架构。</li>
                    <li>实时推理： 输入最新的观测数据，生成全球二氧化碳浓度分布图。</li>
                    <li>结果验证： 与独立验证数据集对比，评估模型性能。</li>
                </ul>
            </li>
        </ul>
    </section>

    <!-- ========== 实验结果 ========== -->
    <section id="results" class="section">
        <h2>实验结果</h2>
        <ul>
            <li><strong>数据汇总：</strong> 经过1000次重复采样，CNOT门的平均保真度达到了 <span class="highlight">92.4%</span>，较上一代模型提升了7%。</li>
            <li><strong>图表分析：</strong> （此处可插入图表）量子态布洛赫球分布图显示，实验数据点紧密聚集在目标态附近，离散度较低。</li>
            <li><strong>误差来源：</strong> 主要误差来源于环境热噪声（占比约5%）和脉冲串扰（占比约3%）。</li>
            <li><strong>结论展望：</strong> 实验结果验证了超导方案的可行性。下一步计划引入更高效的纠错码，并尝试扩展至4-qubit系统。</li>
        </ul>
        <p style="margin-top: 20px; text-align: right;">
            汇报人：[你的名字] | 学号：[你的学号] | 日期：202X年X月X日
        </p>
    </section>

    <!-- ========== 生成图像 ========== -->
    <section id="generate-image" class="section">
        <h2>生成图像</h2>
        <div id="data-submission-section">
            <form id="co2UploadForm">
                <label for="datasetFile">选择您的数据集文件 (.csv, .nc, .npz)</label>
                <input type="file" id="datasetFile" name="dataset" accept=".csv,.nc,.npz" required>
                <button type="submit" id="submitBtn">生成 CO₂ 浓度图像</button>
            </form>

            <div id="resultContainer">
                <div id="loadingMessage" style="display: none;">
                    <p>正在使用 CO₂-Net 模型处理您的数据，请稍候...</p>
                    <div class="spinner"></div>
                </div>
                <div id="errorMessage" style="display: none;"></div>
                <div id="imageResult" style="display: none;">
                    <h3>您的 CO₂ 浓度重建结果</h3>
                    <img id="generatedImage" src="" alt="Generated CO2 Concentration Map">
                </div>
            </div>
        </div>
    </section>

    <!-- ========== 页脚 ========== -->
    <footer class="container">
        <p>&copy; 2026 灵犀智碳团队. 保留所有权利.</p>
    </footer>

    <!-- ========== 前端JavaScript逻辑 ========== -->
    <script>
        // 平滑滚动到锚点
        document.querySelectorAll('nav a').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop,
                        behavior: 'smooth'
                    });
                    // 更新导航状态
                    document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
                    this.classList.add('active');
                }
            });
        });

        // 提交表单逻辑
        document.getElementById('co2UploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const fileInput = document.getElementById('datasetFile');
            const submitBtn = document.getElementById('submitBtn');
            const resultContainer = document.getElementById('resultContainer');
            const loadingMessage = document.getElementById('loadingMessage');
            const errorMessage = document.getElementById('errorMessage');
            const imageResult = document.getElementById('imageResult');
            const generatedImage = document.getElementById('generatedImage');

            // 重置状态
            resultContainer.style.display = 'block';
            loadingMessage.style.display = 'block';
            errorMessage.style.display = 'none';
            imageResult.style.display = 'none';
            submitBtn.disabled = true;
            submitBtn.textContent = '处理中...';

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                // 这里需要替换为您的实际后端API地址
                const response = await fetch('/api/generate-co2-map', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const blob = await response.blob();
                    const imageUrl = URL.createObjectURL(blob);
                    generatedImage.src = imageUrl;
                    imageResult.style.display = 'block';
                } else {
                    const errorText = await response.text();
                    errorMessage.textContent = `处理失败：${errorText || '未知错误'}`;
                    errorMessage.style.display = 'block';
                }
            } catch (error) {
                console.error('上传/请求错误:', error);
                errorMessage.textContent = `网络错误：${error.message}`;
                errorMessage.style.display = 'block';
            } finally {
                loadingMessage.style.display = 'none';
                submitBtn.disabled = false;
                submitBtn.textContent = '生成 CO₂ 浓度图像';
            }
        });
    </script>
</body>
</html>

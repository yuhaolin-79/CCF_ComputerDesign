def decode_number(n):
    def num_to_char(val, position=1):
        if position == 1:
            if val == 0:
                return ' '
            elif 1 <= val <= 10:
                return str(val - 1)
            elif 11 <= val <= 36:
                return chr(val - 11 + ord('A'))
        else:
            if 0 <= val <= 9:
                return str(val)
            elif 10 <= val <= 35:
                return chr(val - 10 + ord('A'))
    def char_to_num(c, position=1):
        if position == 1:
            if c == ' ':
                return 0
            elif c.isdigit():
                return int(c) + 1
            elif c.isupper():
                return ord(c) - ord('A') + 11
        else: # Table 3
            if c.isdigit():
                return int(c)
            elif c.isupper():
                return ord(c) - ord('A') + 10
    c6_val = n % 26
    n1 = n // 26
    c5_val = n1 % 26
    n2 = n1 // 26
    c4_val = n2 % 26
    n3 = n2 // 26
    c3_val = n3 % 10
    mid_val = n3 // 10
    c2_val = mid_val % 36
    c1_val = mid_val // 36
    c1 = num_to_char(c1_val, 1)
    c2 = num_to_char(c2_val, 2)
    c3 = num_to_char(c3_val, 2)
    c4 = chr(c4_val + ord('A'))
    c5 = chr(c5_val + ord('A'))
    c6 = chr(c6_val + ord('A'))
    code = c1 + c2 + c3 + c4 + c5 + c6
    return code.strip()

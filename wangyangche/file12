import sys


def evaluate(token, var_dict):
    # 1. 如果不是变量引用，直接返回原内容
    if not token.startswith('$'):
        return token

    # 2. 提取变量名
    var_name = token[1:]

    # 3. 安全检查：变量不存在
    if var_name not in var_dict:
        return ""

    val_type, val_content = var_dict[var_name]

    # 4. 直接赋值：返回存储的字符串
    if val_type == 0:
        return val_content
    # 5. 间接赋值：递归解析表达式列表
    else:
        # 关键：对列表中的每个 token 递归求值，然后拼接
        return "".join(evaluate(t, var_dict) for t in val_content)


def main():
    variables = {}
    MOD = 1000000007

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue

        parts = line.split()
        cmd = parts[0]

        try:
            if cmd == '1' or cmd == '2':
                # 防止只有指令没有参数
                if len(parts) < 3:
                    continue
                var_name = parts[1]
                expr_tokens = parts[2:]

                if cmd == '1':
                    # 立即求值并存储结果
                    resolved_val = "".join(evaluate(token, variables) for token in expr_tokens)
                    variables[var_name] = (0, resolved_val)
                elif cmd == '2':
                    # 只存储表达式，不求值
                    variables[var_name] = (1, expr_tokens)

            elif cmd == '3':
                if len(parts) < 2:
                    continue
                var_name = parts[1]
                if var_name in variables:
                    current_val = evaluate(var_name, variables)
                    print(len(current_val) % MOD)
        except Exception:
            # 忽略处理过程中的任何错误，继续下一行
            pass


if __name__ == "__main__":
    main()
